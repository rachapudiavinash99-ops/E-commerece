# Application Environment Configuration
ENVIRONMENT=development
DEBUG=True
APP_NAME=CodePulse Academy API
APP_VERSION=1.0.0
API_PREFIX=/api
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Security & Secret Keys
SECRET_KEY=super-secret-production-grade-encryption-key-change-in-prod-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration (SQLite default for zero-config local run, PostgreSQL for docker)
DATABASE_URL=sqlite:///./course_market.db
DB_ECHO=False
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# CORS & Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["*"]

# Payment Gateway Configuration
PAYMENT_GATEWAY_MODE=sandbox
MOCK_PAYMENT_SUCCESS_RATE=1.0
PAYMENT_CURRENCY=USD
PAYMENT_WEBHOOK_SECRET=whsec_test_mock_webhook_secret_key_849204820

# Email & Notification Settings
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test@codepulse.io
SMTP_PASSWORD=devpassword
EMAIL_FROM=CodePulse Academy <no-reply@codepulse.io>
USE_MOCK_EMAIL=True

# Certificate Verification Key
CERTIFICATE_SIGNING_SALT=codepulse-cert-crypto-salt-2026
CERTIFICATE_BASE_URL=http://localhost:5173/certificates/verify
